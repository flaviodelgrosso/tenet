{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config.schema.json",
  "title": "Tenet configuration",
  "description": "Configuration for autonomous Tenet runs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "spec_file", "max_cycles", "max_repair_attempts", "agent"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "default": 1,
      "description": "Configuration format version read by tenet."
    },
    "spec_file": {
      "type": "string",
      "default": "spec.md",
      "description": "Project-relative path to the specification that drives the run.",
      "examples": ["spec.md"]
    },
    "max_cycles": {
      "type": "integer",
      "minimum": 0,
      "default": 25,
      "description": "Maximum number of autonomous engineering cycles before the run stops."
    },
    "max_repair_attempts": {
      "type": "integer",
      "minimum": 0,
      "default": 3,
      "description": "Maximum total repair-worker invocations for one work unit across empty implementation and verification-failure recovery."
    },
    "stagnation_limit": {
      "type": "integer",
      "minimum": 1,
      "default": 3,
      "description": "Advanced override for consecutive cycles without requirement progress before the run is blocked."
    },
    "agent": {
      "$ref": "#/$defs/agentConfig"
    },
    "verification": {
      "$ref": "#/$defs/verificationConfig"
    },
    "execution": {
      "$ref": "#/$defs/executionConfig"
    },
    "additional_protected_paths": {
      "$ref": "#/$defs/stringList",
      "default": [],
      "description": "Additional project-relative paths protected in addition to Tenet's mandatory controller-owned paths."
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agentConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "Vendor-neutral ACP launch and session settings.",
      "required": [],
      "oneOf": [{ "required": ["id"] }, { "required": ["custom"] }],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*",
          "description": "Canonical ACP Registry identity."
        },
        "custom": { "$ref": "#/$defs/customAgentConfig" },
        "completion_retries": {
          "type": "integer",
          "minimum": 0,
          "default": 2,
          "description": "Maximum additional model completions per Architect batch, Reconcile operation, or Assess operation—not across the entire multi-batch Architect phase. Structured-output and semantic-validation failures share that per-operation budget. Implement and Repair use the same retry count within each individual worker invocation."
        },
        "preferences": {
          "$ref": "#/$defs/agentPreferences",
          "default": {
            "default": { "thought_level": "high" },
            "roles": {}
          }
        },
        "turn_timeout_secs": { "type": "integer", "minimum": 0, "default": 900 }
      }
    },
    "agentPreferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "#/$defs/rolePreference",
          "default": { "thought_level": "high" }
        },
        "roles": { "$ref": "#/$defs/agentPreferenceRoles", "default": {} }
      }
    },
    "agentPreferenceRoles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "architect": { "$ref": "#/$defs/rolePreference" },
        "reconcile": { "$ref": "#/$defs/rolePreference" },
        "implement": { "$ref": "#/$defs/rolePreference" },
        "repair": { "$ref": "#/$defs/rolePreference" },
        "assess": { "$ref": "#/$defs/rolePreference" }
      }
    },
    "rolePreference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string" },
        "thought_level": { "type": "string" },
        "mode": { "type": "string" }
      }
    },
    "customAgentConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "args": { "$ref": "#/$defs/stringList", "default": [] },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "projectVerificationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*",
          "description": "Diagnostic name for this check. The name has no verification semantics."
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            { "type": "string", "minLength": 1, "pattern": ".*\\S.*" }
          ],
          "items": { "type": "string" },
          "description": "Structured command: executable followed by zero or more arguments."
        },
        "working_directory": {
          "type": "string",
          "default": ".",
          "minLength": 1,
          "description": "Repository-relative working directory inside the isolated verification workspace."
        },
        "environment": {
          "type": "object",
          "default": {},
          "additionalProperties": { "type": "string" }
        },
        "timeout_secs": {
          "type": "integer",
          "minimum": 1,
          "description": "Optional timeout override for this check."
        }
      }
    },
    "trustedIsolationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_filesystem": { "type": "string", "const": "read_only", "default": "read_only" },
        "root_filesystem": { "type": "string", "const": "read_only", "default": "read_only" },
        "temporary_filesystem": { "type": "string", "const": "disposable_tmpfs", "default": "disposable_tmpfs" },
        "network": { "type": "string", "const": "disabled", "default": "disabled" },
        "environment": { "type": "string", "const": "explicit_only", "default": "explicit_only" },
        "process_namespace": { "type": "string", "const": "private", "default": "private" },
        "control_plane": { "type": "string", "const": "exclusive_mutual_tls", "default": "exclusive_mutual_tls" }
      }
    },
    "trustedResourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory_bytes": { "type": "integer", "minimum": 6291456, "default": 1073741824 },
        "cpu_millis": { "type": "integer", "minimum": 1, "default": 1000 },
        "process_limit": { "type": "integer", "minimum": 1, "default": 256 },
        "writable_tmp_bytes": { "type": "integer", "minimum": 1, "default": 536870912 }
      }
    },
    "trustedVerificationSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "backend", "image", "program"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "backend": { "type": "string", "const": "docker" },
        "image": {
          "type": "string",
          "pattern": "^.+@sha256:[0-9A-Fa-f]{64}$",
          "description": "Controller-selected immutable verifier image reference."
        },
        "program": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "args": { "$ref": "#/$defs/stringList", "default": [] },
        "working_directory": { "type": "string", "minLength": 1, "default": "." },
        "environment": {
          "type": "object",
          "default": {},
          "propertyNames": { "not": { "enum": ["HOME", "TMPDIR", ""] } },
          "additionalProperties": { "type": "string" }
        },
        "timeout_secs": { "type": "integer", "minimum": 1, "default": 300 },
        "isolation": { "$ref": "#/$defs/trustedIsolationPolicy" },
        "resources": { "$ref": "#/$defs/trustedResourcePolicy" },
        "protocol": { "type": "string", "const": "exit_code", "default": "exit_code" }
      }
    },
    "verificationConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "Ordered, controller-trusted project checks and execution limits.",
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/projectVerificationCheck" },
          "default": [],
          "description": "Mandatory project verification checks executed in declaration order with fail-fast behavior."
        },
        "trusted_checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/trustedVerificationSpec" },
          "default": [],
          "description": "Named controller-owned checks executed only through enforced trusted isolation."
        },
        "timeout_secs": {
          "type": "integer",
          "minimum": 1,
          "default": 300,
          "description": "Default maximum duration of each project verification check."
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 0,
          "default": 65536,
          "description": "Output bytes retained from each project verification check."
        }
      }
    },
    "executionConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_parallel_workers": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Advanced override for concurrent coding workers."
        }
      }
    }
  }
}
