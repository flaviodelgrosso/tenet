{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/flaviodelgrosso/loops/main/schemas/config.schema.json",
  "title": "loops configuration",
  "description": "Configuration for autonomous loops runs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "spec_file",
    "max_cycles",
    "max_repair_attempts",
    "stagnation_limit",
    "agent",
    "verification",
    "git",
    "protected_paths"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 0,
      "default": 1,
      "description": "Configuration format version read by loops."
    },
    "spec_file": {
      "type": "string",
      "default": ".loops/spec.md",
      "description": "Project-relative path to the specification that drives the run.",
      "examples": [".loops/spec.md"]
    },
    "max_cycles": {
      "type": "integer",
      "minimum": 0,
      "default": 25,
      "description": "Maximum number of autonomous engineering cycles before the run stops."
    },
    "max_repair_attempts": {
      "type": "integer",
      "minimum": 0,
      "default": 3,
      "description": "Maximum repair attempts for a work unit whose verification fails."
    },
    "stagnation_limit": {
      "type": "integer",
      "minimum": 0,
      "default": 3,
      "description": "Number of consecutive cycles without requirement progress before the run is blocked."
    },
    "agent": {
      "$ref": "#/$defs/agentConfig"
    },
    "verification": {
      "$ref": "#/$defs/verificationConfig"
    },
    "git": {
      "$ref": "#/$defs/gitConfig"
    },
    "protected_paths": {
      "$ref": "#/$defs/stringList",
      "default": [
        ".loops/spec.md",
        "AGENTS.md",
        "loops.toml",
        ".loops/state.json",
        ".loops/requirements.json",
        ".loops/roadmap.json",
        ".loops/STOP",
        ".loops/run.lock"
      ],
      "description": "Project-relative paths restored if a coding worker modifies them.",
      "examples": [[".loops/spec.md", "AGENTS.md", "loops.toml"]]
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agentConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "Vendor-neutral ACP launch and session settings.",
      "required": ["turn_timeout_secs"],
      "oneOf": [{ "required": ["id"] }, { "required": ["custom"] }],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": ".*\\S.*", "description": "Canonical ACP Registry identity." },
        "custom": { "$ref": "#/$defs/customAgentConfig" },
        "completion_retries": { "type": "integer", "minimum": 0, "default": 2 },
        "preferences": {
          "$ref": "#/$defs/agentPreferences",
          "default": {
            "default": { "thought_level": "high" },
            "roles": {}
          }
        },
        "turn_timeout_secs": { "type": "integer", "minimum": 0, "default": 900 }
      }
    },
    "agentPreferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "$ref": "#/$defs/rolePreference", "default": { "thought_level": "high" } },
        "roles": { "$ref": "#/$defs/agentPreferenceRoles", "default": {} }
      }
    },
    "agentPreferenceRoles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "architect": { "$ref": "#/$defs/rolePreference" },
        "reconcile": { "$ref": "#/$defs/rolePreference" },
        "implement": { "$ref": "#/$defs/rolePreference" },
        "repair": { "$ref": "#/$defs/rolePreference" },
        "assess": { "$ref": "#/$defs/rolePreference" }
      }
    },
    "rolePreference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string" },
        "thought_level": { "type": "string" },
        "mode": { "type": "string" },
        "required": { "type": "boolean", "default": false }
      }
    },
    "customAgentConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "args": { "$ref": "#/$defs/stringList", "default": [] },
        "env": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "verificationConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "Deterministic commands and limits used to verify each implemented work unit.",
      "required": [
        "require_project_gate",
        "commands",
        "timeout_secs",
        "max_output_bytes"
      ],
      "properties": {
        "require_project_gate": {
          "type": "boolean",
          "default": true,
          "description": "Requires at least one project-specific verification command before work can pass."
        },
        "commands": {
          "$ref": "#/$defs/stringList",
          "default": [],
          "description": "Explicit shell commands run as project verification gates.",
          "examples": [["cargo test", "cargo clippy --all-targets -- -D warnings"]]
        },
        "timeout_secs": {
          "type": "integer",
          "minimum": 0,
          "default": 120,
          "description": "Maximum duration in seconds allowed for each verification command."
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 0,
          "default": 65536,
          "description": "Maximum number of output bytes retained from each verification command."
        }
      }
    },
    "gitConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "Repository initialization, commit, and cleanliness safeguards.",
      "required": ["init", "auto_commit", "require_clean_tree"],
      "properties": {
        "init": {
          "type": "boolean",
          "default": true,
          "description": "Initializes a Git repository when the project is not already inside one."
        },
        "auto_commit": {
          "type": "boolean",
          "default": false,
          "description": "Creates loops-managed commits for accepted autonomous changes."
        },
        "require_clean_tree": {
          "type": "boolean",
          "default": false,
          "description": "Refuses to start a run when the Git working tree already has changes."
        }
      }
    }
  }
}
