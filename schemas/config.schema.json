{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/flaviodelgrosso/tenet/main/schemas/config.schema.json",
  "title": "Tenet configuration",
  "description": "Configuration for autonomous Tenet runs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "spec_file",
    "max_cycles",
    "max_repair_attempts",
    "stagnation_limit",
    "agent",
    "verification",
    "execution",
    "integration",
    "protected_paths"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "default": 1,
      "description": "Configuration format version read by tenet."
    },
    "spec_file": {
      "type": "string",
      "default": ".tenet/spec.md",
      "description": "Project-relative path to the specification that drives the run.",
      "examples": [".tenet/spec.md"]
    },
    "max_cycles": {
      "type": "integer",
      "minimum": 0,
      "default": 25,
      "description": "Maximum number of autonomous engineering cycles before the run stops."
    },
    "max_repair_attempts": {
      "type": "integer",
      "minimum": 0,
      "default": 3,
      "description": "Maximum repair attempts for a work unit whose verification fails."
    },
    "stagnation_limit": {
      "type": "integer",
      "minimum": 1,
      "default": 3,
      "description": "Number of consecutive cycles without requirement progress before the run is blocked."
    },
    "agent": {
      "$ref": "#/$defs/agentConfig"
    },
    "verification": {
      "$ref": "#/$defs/verificationConfig"
    },
    "execution": {
      "$ref": "#/$defs/executionConfig"
    },
    "integration": {
      "$ref": "#/$defs/integrationConfig"
    },
    "protected_paths": {
      "$ref": "#/$defs/stringList",
      "default": [
        ".tenet/spec.md",
        "AGENTS.md",
        "tenet.toml",
        ".tenet/state.json",
        ".tenet/requirements.json",
        ".tenet/roadmap.json",
        ".tenet/STOP",
        ".tenet/run.lock"
      ],
      "description": "Project-relative paths restored if a coding worker modifies them.",
      "examples": [[".tenet/spec.md", "AGENTS.md", "tenet.toml"]]
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agentConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "Vendor-neutral ACP launch and session settings.",
      "required": ["turn_timeout_secs"],
      "oneOf": [{ "required": ["id"] }, { "required": ["custom"] }],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": ".*\\S.*", "description": "Canonical ACP Registry identity." },
        "custom": { "$ref": "#/$defs/customAgentConfig" },
        "completion_retries": { "type": "integer", "minimum": 0, "default": 2 },
        "preferences": {
          "$ref": "#/$defs/agentPreferences",
          "default": {
            "default": { "thought_level": "high" },
            "roles": {}
          }
        },
        "turn_timeout_secs": { "type": "integer", "minimum": 0, "default": 900 }
      }
    },
    "agentPreferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "$ref": "#/$defs/rolePreference", "default": { "thought_level": "high" } },
        "roles": { "$ref": "#/$defs/agentPreferenceRoles", "default": {} }
      }
    },
    "agentPreferenceRoles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "architect": { "$ref": "#/$defs/rolePreference" },
        "reconcile": { "$ref": "#/$defs/rolePreference" },
        "implement": { "$ref": "#/$defs/rolePreference" },
        "repair": { "$ref": "#/$defs/rolePreference" },
        "assess": { "$ref": "#/$defs/rolePreference" }
      }
    },
    "rolePreference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string" },
        "thought_level": { "type": "string" },
        "mode": { "type": "string" }
      }
    },
    "customAgentConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "args": { "$ref": "#/$defs/stringList", "default": [] },
        "env": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "verificationSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program", "args", "workingDirectory", "environment"],
      "properties": {
        "program": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "args": { "$ref": "#/$defs/stringList", "default": [] },
        "workingDirectory": { "type": "string", "default": ".", "minLength": 1 },
        "environment": { "type": "object", "default": {}, "additionalProperties": { "type": "string" } }
      }
    },
    "projectVerificationGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_ids", "spec", "dependency_scope"],
      "properties": {
        "obligation_ids": { "$ref": "#/$defs/stringList", "minItems": 1 },
        "spec": { "$ref": "#/$defs/verificationSpec" },
        "dependency_scope": { "$ref": "#/$defs/stringList", "minItems": 1 }
      }
    },
    "verificationConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "Structured, controller-trusted verification gates and execution limits.",
      "required": [
        "require_project_gate",
        "gates",
        "timeout_secs",
        "max_output_bytes"
      ],
      "properties": {
        "require_project_gate": {
          "type": "boolean",
          "default": false,
          "description": "Requires at least one explicitly obligation-bound project gate before work can pass."
        },
        "gates": {
          "type": "array",
          "items": { "$ref": "#/$defs/projectVerificationGate" },
          "default": [],
          "description": "Project-configured verification specs explicitly bound to obligation identities."
        },
        "timeout_secs": {
          "type": "integer",
          "minimum": 0,
          "default": 120,
          "description": "Maximum duration in seconds allowed for each verification command."
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 0,
          "default": 65536,
          "description": "Maximum number of output bytes retained from each verification command."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "require_project_gate": { "const": true }
            }
          },
          "then": {
            "properties": {
              "gates": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "executionConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_parallel_workers"],
      "properties": {
        "max_parallel_workers": { "type": "integer", "minimum": 1, "default": 1 }
      }
    },
    "integrationConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "verify_each_candidate"],
      "properties": {
        "strategy": { "type": "string", "const": "cherry_pick", "default": "cherry_pick" },
        "verify_each_candidate": { "type": "boolean", "default": true }
      }
    }
  }
}
