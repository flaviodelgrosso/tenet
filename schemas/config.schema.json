{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config.schema.json",
  "title": "Tenet configuration",
  "description": "Configuration for autonomous Tenet runs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "spec_file", "max_cycles", "max_repair_attempts", "agent"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "default": 1,
      "description": "Configuration format version read by tenet."
    },
    "spec_file": {
      "type": "string",
      "default": "spec.md",
      "description": "Project-relative path to the specification that drives the run.",
      "examples": ["spec.md"]
    },
    "max_cycles": {
      "type": "integer",
      "minimum": 0,
      "default": 25,
      "description": "Maximum number of autonomous engineering cycles before the run stops."
    },
    "max_repair_attempts": {
      "type": "integer",
      "minimum": 0,
      "default": 3,
      "description": "Maximum total repair-worker invocations for one work unit across empty implementation and verification-failure recovery."
    },
    "stagnation_limit": {
      "type": "integer",
      "minimum": 1,
      "default": 3,
      "description": "Advanced override for consecutive cycles without requirement progress before the run is blocked."
    },
    "agent": {
      "$ref": "#/$defs/agentConfig"
    },
    "verification": {
      "$ref": "#/$defs/verificationConfig"
    },
    "execution": {
      "$ref": "#/$defs/executionConfig"
    },
    "additional_protected_paths": {
      "$ref": "#/$defs/stringList",
      "default": [],
      "description": "Additional project-relative paths protected in addition to Tenet's mandatory controller-owned paths."
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agentConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "Vendor-neutral ACP launch and session settings.",
      "required": [],
      "oneOf": [{ "required": ["id"] }, { "required": ["custom"] }],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*",
          "description": "Canonical ACP Registry identity."
        },
        "custom": { "$ref": "#/$defs/customAgentConfig" },
        "completion_retries": {
          "type": "integer",
          "minimum": 0,
          "default": 2,
          "description": "Maximum additional model completions per Architect batch, Reconcile operation, or Assess operation—not across the entire multi-batch Architect phase. Structured-output and semantic-validation failures share that per-operation budget. Implement and Repair use the same retry count within each individual worker invocation."
        },
        "preferences": {
          "$ref": "#/$defs/agentPreferences",
          "default": {
            "default": { "thought_level": "high" },
            "roles": {}
          }
        },
        "turn_timeout_secs": { "type": "integer", "minimum": 0, "default": 900 }
      }
    },
    "agentPreferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "#/$defs/rolePreference",
          "default": { "thought_level": "high" }
        },
        "roles": { "$ref": "#/$defs/agentPreferenceRoles", "default": {} }
      }
    },
    "agentPreferenceRoles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "architect": { "$ref": "#/$defs/rolePreference" },
        "reconcile": { "$ref": "#/$defs/rolePreference" },
        "implement": { "$ref": "#/$defs/rolePreference" },
        "repair": { "$ref": "#/$defs/rolePreference" },
        "assess": { "$ref": "#/$defs/rolePreference" }
      }
    },
    "rolePreference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string" },
        "thought_level": { "type": "string" },
        "mode": { "type": "string" }
      }
    },
    "customAgentConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "args": { "$ref": "#/$defs/stringList", "default": [] },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "projectVerificationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*",
          "description": "Diagnostic name for this check. The name has no verification semantics."
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            { "type": "string", "minLength": 1, "pattern": ".*\\S.*" }
          ],
          "items": { "type": "string" },
          "description": "Structured command: executable followed by zero or more arguments."
        },
        "working_directory": {
          "type": "string",
          "default": ".",
          "minLength": 1,
          "description": "Repository-relative working directory inside the isolated verification workspace."
        },
        "environment": {
          "type": "object",
          "default": {},
          "additionalProperties": { "type": "string" }
        },
        "timeout_secs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600,
          "description": "Optional timeout override for this check."
        }
      }
    },
    "trustedIsolationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "boundary": { "type": "string", "const": "hardware_virtualized_micro_vm", "default": "hardware_virtualized_micro_vm" },
        "candidate_filesystem": { "type": "string", "const": "private_writable", "default": "private_writable" },
        "host_repository_mounts": { "type": "string", "const": "none", "default": "none" },
        "writable_storage": { "type": "string", "const": "disposable_sandbox_private", "default": "disposable_sandbox_private" },
        "network": { "type": "string", "const": "disabled", "default": "disabled" },
        "environment": { "type": "string", "const": "explicit_only", "default": "explicit_only" },
        "guest_security_profile": { "type": "string", "const": "restricted", "default": "restricted" },
        "control_channel": { "type": "string", "const": "local_host_driven", "default": "local_host_driven" }
      }
    },
    "trustedResourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory_mib": { "type": "integer", "minimum": 128, "maximum": 16384, "default": 1024 },
        "vcpus": { "type": "integer", "minimum": 1, "maximum": 16, "default": 1 },
        "process_limit": { "type": "integer", "minimum": 1, "maximum": 4096, "default": 256 },
        "writable_root_mib": { "type": "integer", "minimum": 1, "maximum": 16384, "default": 4096 },
        "max_input_archive_bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824, "default": 536870912 },
        "max_input_tree_bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824, "default": 268435456 },
        "max_input_entries": { "type": "integer", "minimum": 1, "maximum": 250000, "default": 100000 }
      }
    },
    "dependencyPolicy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy"],
          "properties": { "policy": { "const": "repository_wide" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "patterns"],
          "properties": {
            "policy": { "const": "paths" },
            "patterns": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" }
            }
          }
        }
      ],
      "default": { "policy": "repository_wide" }
    },
    "trustedVerificationSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "backend", "image", "program"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "backend": { "type": "string", "const": "microsandbox" },
        "image": {
          "type": "string",
          "pattern": "^.+@sha256:[0-9A-Fa-f]{64}$",
          "description": "Controller-selected immutable verifier image reference."
        },
        "program": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "args": { "$ref": "#/$defs/stringList", "default": [] },
        "working_directory": { "type": "string", "minLength": 1, "default": "." },
        "environment": {
          "type": "object",
          "default": {},
          "propertyNames": {
            "minLength": 1,
            "allOf": [
              { "not": { "enum": ["HOME", "PATH", "TMPDIR", "USER"] } },
              { "not": { "pattern": "^MSB_" } },
              { "not": { "pattern": "=" } }
            ]
          },
          "additionalProperties": { "type": "string" }
        },
        "timeout_secs": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 300 },
        "isolation": { "$ref": "#/$defs/trustedIsolationPolicy" },
        "resources": { "$ref": "#/$defs/trustedResourcePolicy" },
        "protocol": { "type": "string", "const": "exit_code", "default": "exit_code" }
        ,"dependencies": { "$ref": "#/$defs/dependencyPolicy" }
      }
    },
    "humanAttestorSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "publicKey"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "publicKey": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
        "dependencies": { "$ref": "#/$defs/dependencyPolicy" }
      }
    },
    "structuredFalsifierInputSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "argument"],
      "properties": {
        "schema": { "type": "object" },
        "argument": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
        "maxBytes": { "type": "integer", "minimum": 1, "maximum": 1048576, "default": 16384 }
      }
    },
    "falsifierSpec": {
      "type": "object",
      "description": "Trusted verifier fields plus an explicit bounded falsifier protocol and optional structured input.",
      "required": ["name", "backend", "image", "program"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "backend": { "const": "microsandbox" },
        "image": { "type": "string", "pattern": "^.+@sha256:[0-9A-Fa-f]{64}$" },
        "program": { "type": "string", "minLength": 1 },
        "args": { "$ref": "#/$defs/stringList", "default": [] },
        "working_directory": { "type": "string", "minLength": 1, "default": "." },
        "environment": {
          "type": "object",
          "default": {},
          "propertyNames": {
            "minLength": 1,
            "allOf": [
              { "not": { "enum": ["HOME", "PATH", "TMPDIR", "USER"] } },
              { "not": { "pattern": "^MSB_" } },
              { "not": { "pattern": "=" } }
            ]
          },
          "additionalProperties": { "type": "string" }
        },
        "timeout_secs": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 300 },
        "isolation": { "$ref": "#/$defs/trustedIsolationPolicy" },
        "resources": { "$ref": "#/$defs/trustedResourcePolicy" },
        "protocol": { "const": "exit_code", "default": "exit_code" },
        "dependencies": { "$ref": "#/$defs/dependencyPolicy" },
        "result_protocol": { "const": "exit_code", "default": "exit_code" },
        "input": { "$ref": "#/$defs/structuredFalsifierInputSpec" }
      },
      "additionalProperties": false
    },
    "verificationConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "Ordered, controller-trusted project checks and execution limits.",
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/projectVerificationCheck" },
          "default": [],
          "description": "Mandatory project verification checks executed in declaration order with fail-fast behavior."
        },
        "trusted_checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/trustedVerificationSpec" },
          "default": [],
          "description": "Named controller-owned checks executed only through enforced trusted isolation."
        },
        "falsifiers": {
          "type": "array",
          "items": { "$ref": "#/$defs/falsifierSpec" },
          "default": []
        },
        "human_attestors": {
          "type": "array",
          "items": { "$ref": "#/$defs/humanAttestorSpec" },
          "default": []
        },
        "timeout_secs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600,
          "default": 300,
          "description": "Default maximum duration of each project verification check."
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216,
          "default": 65536,
          "description": "Output bytes retained from each project verification check."
        }
      }
    },
    "executionConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_parallel_workers": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Advanced override for concurrent coding workers."
        }
      }
    }
  }
}
