{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config.schema.json",
  "title": "Tenet configuration",
  "description": "Configuration for autonomous Tenet runs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "spec_file", "max_cycles", "max_repair_attempts", "agent"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "default": 1,
      "description": "Configuration format version read by tenet."
    },
    "spec_file": {
      "type": "string",
      "default": "spec.md",
      "description": "Project-relative path to the specification that drives the run.",
      "examples": ["spec.md"]
    },
    "max_cycles": {
      "type": "integer",
      "minimum": 0,
      "default": 25,
      "description": "Maximum number of autonomous engineering cycles before the run stops."
    },
    "max_repair_attempts": {
      "type": "integer",
      "minimum": 0,
      "default": 3,
      "description": "Maximum repair attempts for a work unit whose verification fails."
    },
    "stagnation_limit": {
      "type": "integer",
      "minimum": 1,
      "default": 3,
      "description": "Advanced override for consecutive cycles without requirement progress before the run is blocked."
    },
    "agent": {
      "$ref": "#/$defs/agentConfig"
    },
    "verification": {
      "$ref": "#/$defs/verificationConfig"
    },
    "execution": {
      "$ref": "#/$defs/executionConfig"
    },
    "additional_protected_paths": {
      "$ref": "#/$defs/stringList",
      "default": [],
      "description": "Additional project-relative paths protected in addition to Tenet's mandatory controller-owned paths."
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agentConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "Vendor-neutral ACP launch and session settings.",
      "required": [],
      "oneOf": [{ "required": ["id"] }, { "required": ["custom"] }],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*",
          "description": "Canonical ACP Registry identity."
        },
        "custom": { "$ref": "#/$defs/customAgentConfig" },
        "completion_retries": { "type": "integer", "minimum": 0, "default": 2 },
        "preferences": {
          "$ref": "#/$defs/agentPreferences",
          "default": {
            "default": { "thought_level": "high" },
            "roles": {}
          }
        },
        "turn_timeout_secs": { "type": "integer", "minimum": 0, "default": 900 }
      }
    },
    "agentPreferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "#/$defs/rolePreference",
          "default": { "thought_level": "high" }
        },
        "roles": { "$ref": "#/$defs/agentPreferenceRoles", "default": {} }
      }
    },
    "agentPreferenceRoles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "architect": { "$ref": "#/$defs/rolePreference" },
        "reconcile": { "$ref": "#/$defs/rolePreference" },
        "implement": { "$ref": "#/$defs/rolePreference" },
        "repair": { "$ref": "#/$defs/rolePreference" },
        "assess": { "$ref": "#/$defs/rolePreference" }
      }
    },
    "rolePreference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string" },
        "thought_level": { "type": "string" },
        "mode": { "type": "string" }
      }
    },
    "customAgentConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "args": { "$ref": "#/$defs/stringList", "default": [] },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "projectVerificationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*",
          "description": "Diagnostic name for this check. The name has no verification semantics."
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            { "type": "string", "minLength": 1, "pattern": ".*\\S.*" }
          ],
          "items": { "type": "string" },
          "description": "Structured command: executable followed by zero or more arguments."
        },
        "working_directory": {
          "type": "string",
          "default": ".",
          "minLength": 1,
          "description": "Repository-relative working directory inside the isolated verification workspace."
        },
        "environment": {
          "type": "object",
          "default": {},
          "additionalProperties": { "type": "string" }
        },
        "timeout_secs": {
          "type": "integer",
          "minimum": 1,
          "description": "Optional timeout override for this check."
        }
      }
    },
    "verificationConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "Ordered, controller-trusted project checks and execution limits.",
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/projectVerificationCheck" },
          "default": [],
          "description": "Mandatory project verification checks executed in declaration order with fail-fast behavior."
        },
        "timeout_secs": {
          "type": "integer",
          "minimum": 1,
          "default": 300,
          "description": "Default maximum duration of each project verification check."
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 0,
          "default": 65536,
          "description": "Output bytes retained from each project verification check."
        }
      }
    },
    "executionConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_parallel_workers": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Advanced override for concurrent coding workers."
        }
      }
    }
  }
}
